# Copy to .env.local and fill in. Never commit .env.local.

# Required. The key's team must have the Baselayer Exa Connect provider enabled
# for the KYB verification step (billed ~$1.00 per business search).
EXA_API_KEY=

# Required for the risk-memo synthesis step.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Public HTTPS origin of this app (e.g. https://vetted.vercel.app).
# Exa Monitors deliver results by webhook, so real monitors are only created when
# this is set; otherwise /api/monitor falls back to an in-memory local monitor.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically.
# APP_URL=
